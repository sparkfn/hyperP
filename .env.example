# Single source of truth for env vars across api / web / ingestion services.
# Copy to .env at the repo root. Both docker-compose and service-local dev
# reads pick up values from here.

# --- Host port mappings (docker-compose) -----------------------------------
# Override these if the defaults clash with something already running on the
# host. Container-internal ports are unchanged.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Primary ingress via nginx. The frontend and api services are not exposed directly.
NGINX_PORT=80

# --- Neo4j ------------------------------------------------------------------
NEO4J_PASSWORD=changeme

# --- Frontend (Next.js BFF) ------------------------------------------------
# Server-only origin the Next.js Route Handlers use to reach FastAPI. Inside the
# docker network the default (http://api:3000) works; override when running
# the frontend container against a non-compose API (e.g. a deployed environment).
API_BASE_URL=http://api:3000

# --- Timezone ---------------------------------------------------------------
# Used by the backend (TZ) and frontend2 (NEXT_PUBLIC_TZ). Affects date display
# in the UI and any server-side datetime formatting. Examples: Asia/Singapore,
# UTC, America/New_York.
TZ=Asia/Singapore

# --- Authentication (Google SSO via Auth.js v5) ----------------------------
# Shared across api (verifies ID tokens) and web (runs the OAuth flow).
AUTH_ENABLED=true
# Google Cloud Console → Credentials → OAuth 2.0 Web application.
# Authorized redirect URI to register:
#   http://localhost/bff/auth/callback/google  (via nginx on NGINX_PORT)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional — restrict sign-in to a single Google Workspace `hd`. Leave empty
# to allow any Google account. Enforced by the api.
AUTH_GOOGLE_HOSTED_DOMAIN=
# --- OAuth2 client credentials (server-to-server auth) ----------------------
# HyperP issues RS256 JWT access tokens from POST /v1/oauth/token.
# Generate local key material with:
#   openssl genrsa -out oauth-private.pem 2048
#   openssl rsa -in oauth-private.pem -pubout -out oauth-public.pem
# Then paste PEM contents as single-line escaped values or provide them via your
# deployment secret manager. Generate the hash key with: `openssl rand -base64 32`.
OAUTH_ISSUER=http://localhost/api
OAUTH_AUDIENCE=hyperp-api
# Access-token lifetime is configured per OAuth client (300–86400s), not here.
OAUTH_ACTIVE_KEY_ID=local-dev
OAUTH_PRIVATE_KEY_PEM=
OAUTH_PUBLIC_KEY_PEM=
OAUTH_SECRET_HASH_KEY=

# --- Ingestion LLM connectors ----------------------------------------------
# GPT connector (retained; ingestion workloads currently route through ProClaude).
GPT_API_BASE_URL=https://gpt.ada.asia/api/v1
GPT_API_KEY=
GPT_DEFAULT_MODEL=gpt-4o

# ProClaude is the backend for matching, chat, and address-normalization
# workloads. A service credential invokes /openai/v1/chat/completions and
# validates the configured model through /openai/v1/models.
# Required — chat ingestion yields 0 records without a key.
PROCLAUDE_API_BASE_URL=https://proclaude.sparkfn.io
PROCLAUDE_API_KEY=
PROCLAUDE_DEFAULT_MODEL=claude-sonnet-4

# --- Ingestion config (exclusions + LLM call tuning) ------------------------
# Path (inside the container) to the consolidated ingestion config JSON. The
# `llm` block holds timeout/request-delay/retry tuning; the `exclusions` block
# holds hard-exclusion identifiers. See config/ingestion-config.example.json.
INGESTION_CONFIG_FILE=/app/config/ingestion-config.example.json

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Authentication token expiry (minutes, defaults applied if unset) --------
# ACCESS_TOKEN_EXPIRY_MINUTES  — minutes before a Google access token is considered expired (default 60)
# REFRESH_TOKEN_EXPIRY_MINUTES — minutes before a refresh token is considered expired (default 43200 = 30 days)

# --- Public share pages -------------------------------------------------------
# Minutes before a generated person public-page share link expires (default 30).
PUBLIC_PAGE_EXPIRY_MINUTES=30

# Auth.js session JWT signing key. Generate with: `openssl rand -base64 32`.
AUTH_SECRET=
# Rolling idle window for the Auth.js session cookie, in seconds (default 3600
# if unset/invalid). The cookie is re-issued on each request, so this is an
# inactivity timeout, not an absolute cap. 18000 = 5 hours.
AUTH_SESSION_MAX_AGE_SECONDS=18000
# Public base URL of the app as served by nginx.
NEXTAUTH_URL=http://localhost
# Comma-separated emails auto-promoted to role=admin on first login. This is
# how the FIRST admin gets in; subsequent users are created as role=first_time
# and must be granted access via the /admin/users page.
BOOTSTRAP_ADMIN_EMAILS=

# --- Ingestion service & Celery --------------------------------------------
LOG_LEVEL=INFO
BATCH_SIZE=1000

# Celery worker concurrency (per-worker process count)
CELERY_WORKER_CONCURRENCY=1
# Max concurrent ingestion runs across the entire cluster (Redis semaphore).
# Independent of CELERY_WORKER_CONCURRENCY.
MAX_CONCURRENT_INGESTIONS=1

# Bounded Person profile analysis (disabled by default)
PROFILE_ANALYSIS_ENABLED=false
PROFILE_ANALYSIS_CLAIM_LEASE_SECONDS=900
PROFILE_ANALYSIS_RETRY_LIMIT=3

# --- Fundbox source database (MySQL, optionally via SSH tunnel) -------------
# Set FUNDBOX_SSH_HOST to enable SSH tunnelling; leave empty for direct connect.
FUNDBOX_SSH_HOST=
FUNDBOX_SSH_PORT=
FUNDBOX_SSH_USER=
FUNDBOX_SSH_PASSWORD=
FUNDBOX_DB_HOST=
FUNDBOX_DB_PORT=
FUNDBOX_DB_USER=
FUNDBOX_DB_PASSWORD=
FUNDBOX_DB_NAME=
FUNDBOX_CHUNK_SIZE=
# Beat schedule (5-field cron, empty = disabled). Example: "0 */6 * * *"
FUNDBOX_INGEST_CRON=

# --- Fundbox backdoor API ingestion ----------------------------------------
FUNDBOX_API_BASE_URL=
FUNDBOX_API_USERNAME=
FUNDBOX_API_PASSWORD=
FUNDBOX_API_PAGE_SIZE=100
FUNDBOX_API_TIMEOUT_SECONDS=30
FUNDBOX_API_MAX_ATTEMPTS=3
FUNDBOX_API_OVERLAP_SECONDS=300

# --- SpeedZone POS source database (MySQL, optionally via SSH tunnel) -------
SPEEDZONE_SSH_HOST=
SPEEDZONE_SSH_PORT=
SPEEDZONE_SSH_USER=
SPEEDZONE_SSH_PASSWORD=
SPEEDZONE_DB_HOST=
SPEEDZONE_DB_PORT=
SPEEDZONE_DB_USER=
SPEEDZONE_DB_PASSWORD=
SPEEDZONE_DB_NAME=
SPEEDZONE_CHUNK_SIZE=
SPEEDZONE_INGEST_CRON=

# --- PHPPOS OAuth API ingestion --------------------------------------------
PHPPOS_API_BASE_URL=
PHPPOS_API_CLIENT_ID=
PHPPOS_API_CLIENT_SECRET=
PHPPOS_API_PAGE_SIZE=500
PHPPOS_API_TIMEOUT_SECONDS=30
PHPPOS_API_MAX_ATTEMPTS=3
SPEEDZONE_PHPPOS_API_TENANT_ID=
EKO_PHPPOS_API_TENANT_ID=

# --- SG bankruptcy scraper API ingestion ----------------------------------
SGBANKRUPTCY_API_BASE_URL=
SGBANKRUPTCY_API_KEY=
SGBANKRUPTCY_API_PAGE_SIZE=500
SGBANKRUPTCY_API_TIMEOUT_SECONDS=30
SGBANKRUPTCY_API_MAX_ATTEMPTS=3
SGBANKRUPTCY_INGEST_CRON=

# --- SG rental flats API ingestion -----------------------------------------
SGRENTALFLATS_API_BASE_URL=https://sgrentalflats-api.ada.asia
SGRENTALFLATS_API_KEY=
SGRENTALFLATS_API_PAGE_SIZE=500
SGRENTALFLATS_API_TIMEOUT_SECONDS=30

# --- WhatsAdmin extraction API (whatsapp_chat mode=api) --------------------
WHATSADMIN_API_BASE_URL=
WHATSADMIN_EKO_API_KEY=hk_replace_with_eko_handle_key
WHATSADMIN_SPEEDZONE_API_KEY=hk_replace_with_speedzone_handle_key
WHATSADMIN_EKO_ENABLED=false
WHATSADMIN_SPEEDZONE_ENABLED=false
# Existing deployments only: organization that owned the retired global key.
WHATSADMIN_LEGACY_ENTITY=
WHATSADMIN_API_PAGE_SIZE=25
WHATSADMIN_API_TIMEOUT_SECONDS=120
WHATSADMIN_API_MAX_ATTEMPTS=5
WHATSADMIN_API_RETRY_BASE_DELAY_SECONDS=1

# --- Bitrix Open Lines API (bitrix_chat mode=api/backfill) -----------------
# Inbound-webhook base URL; treat the full value as a secret.
BITRIX_OPENLINES_API_BASE_URL=
BITRIX_OPENLINES_API_TIMEOUT_SECONDS=30
BITRIX_OPENLINES_API_MAX_ATTEMPTS=3
BITRIX_OPENLINES_API_REQUEST_DELAY_SECONDS=0.5

# --- Eko POS source database (MySQL, optionally via SSH tunnel) -------------
EKO_SSH_HOST=
EKO_SSH_PORT=
EKO_SSH_USER=
EKO_SSH_PASSWORD=
EKO_DB_HOST=
EKO_DB_PORT=
EKO_DB_USER=
EKO_DB_PASSWORD=
EKO_DB_NAME=
EKO_CHUNK_SIZE=
EKO_INGEST_CRON=
